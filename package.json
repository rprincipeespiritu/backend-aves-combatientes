{
  "name": "backend-aves-combatientes",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@cap-js/postgres": "^2.1.3",
    "@sap/cds": "^9",
    "@sap/cds-dk": "^9.8.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "sqlite3": "^5.1.7"
  },
  "scripts": {
    "start": "cds-serve",
    "migrate": "cds deploy",
    "watch": "cds watch",
    "deploy": "cds deploy",
    "build": "cds build",
    "test": "node --test test/*.test.js",
    "debug": "node --inspect ./node_modules/@sap/cds-dk/bin/cds.js watch",
    "debug:brk": "node --inspect-brk ./node_modules/@sap/cds-dk/bin/cds.js watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "impl": "@cap-js/postgres",
        "[development]": {
          "credentials": {
            "host": "localhost",
            "port": 5432,
            "user": "postgres",
            "database": "aves_combatientes_db"
          }
        }
      },
      "auth": {
        "impl": "./srv/security/auth.js",
        "restrict_all_services": false
      }
    },
    "server": {
      "cors": false
    }
  }
}
